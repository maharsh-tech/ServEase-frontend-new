# ===== Firebase =====
# Get these from Firebase Console → Project Settings → General → Your apps
# IMPORTANT: Expo requires the EXPO_PUBLIC_ prefix for client-side access
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# ===== Backend API =====
# Choose ONE of these based on your setup:
#
# 1. LOCAL (same WiFi as backend):
#    Run `ipconfig` (Windows) or `ifconfig` (Mac/Linux) to get your LAN IP
#    EXPO_PUBLIC_API_BASE_URL=http://192.168.1.5:8080/api
#
# 2. TUNNEL (cross-network development):
#    Run: npx localtunnel --port 8080 --subdomain serveease-backend
#    EXPO_PUBLIC_API_BASE_URL=https://serveease-backend.loca.lt/api
#
# 3. PRODUCTION (deployed server):
#    EXPO_PUBLIC_API_BASE_URL=https://your-deployed-backend.com/api
#
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LAN_IP:8080/api
